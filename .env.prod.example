# Template สำหรับ .env จริงตอน Deploy ด้วย docker-compose.prod.yml (Phase 8)
# คัดลอกเป็น .env.uat หรือ .env.prod บน Server จริง แล้วกรอกค่าจริง — ห้าม Commit
# ขึ้น Git เด็ดขาด (.gitignore กันไว้แล้ว) เก็บเฉพาะบน Server หรือ Password Manager

APP_ENV=uat
# ตั้งชื่อ Image ตาม Git Tag/Commit เพื่อ Rollback ง่าย เช่น IMAGE_TAG=2026-09-05-a1b2c3d
IMAGE_TAG=latest

APP_NAME=PR-Robot
# สร้างด้วย: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# ต้องตรงกับ POSTGRES_USER/PASSWORD/DB ด้านล่าง — Host เป็นชื่อ Service "db" ใน
# Compose (ไม่ใช่ localhost เพราะรันอยู่คนละ Container กัน สื่อสารผ่าน internal
# network เท่านั้น)
DATABASE_URL=postgresql+psycopg2://pr_robot:CHANGE_ME@db:5432/pr_robot
POSTGRES_USER=pr_robot
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=pr_robot

# Google Gemini API Key (Free Tier) — ใช้ Key จริง (คนละตัวจาก Key ที่ใช้ทดสอบใน
# Sandbox Dev ก็ได้ แล้วแต่ Product Owner ตัดสินใจ)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Path ภายใน Container เท่านั้น (Volume pr_robot_storage Mount ให้แล้วใน Compose)
UPLOAD_DIR=storage/uploads
GENERATED_DIR=storage/generated
