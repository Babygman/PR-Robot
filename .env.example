# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าจริง
# ห้าม Commit ไฟล์ .env ลง Git (ถูก .gitignore กันไว้แล้ว)

APP_ENV=dev
APP_NAME=PR-Robot
SECRET_KEY=change-me-to-a-random-secret

# ต้องตรงกับค่าใน docker-compose.yml (POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB)
DATABASE_URL=postgresql+psycopg2://pr_robot:pr_robot@localhost:5432/pr_robot

# Google Gemini API Key (Free Tier) — ขอได้ที่ https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Model ที่ใช้สกัดข้อมูล — ปรับได้ตาม Quota จริงของ Key (ดูใน Google AI Studio)
GEMINI_MODEL=gemini-2.5-flash

UPLOAD_DIR=storage/uploads
GENERATED_DIR=storage/generated
